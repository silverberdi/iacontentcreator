    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function sql(value) {\n  if (value === undefined || value === null || value === '') return 'NULL';\n  return `'${String(value).replace(/'/g, \"''\")}'`;\n}\nfunction sqlJson(value) {\n  return `${sql(JSON.stringify(value ?? {}))}::jsonb`;\n}\nfunction slug(value, fallback = '') { return String(value || fallback || '').trim(); }\nconst body=$json.body||{}; const avatar=slug(body.avatar); const scene=slug(body.scene); const re=/^[a-z0-9][a-z0-9-]*$/i;\nif(!re.test(avatar)||!re.test(scene)) return {json:{ok:false,skipQuery:true,error:'avatar and scene are required slug-like values',request:{avatar,scene}}};\nconst query=`SELECT sc.avatar, sc.scene, sc.display_name, COALESCE(sb.visual_intent,sc.description,sc.display_name,sc.scene) AS visual_intent, COALESCE(sb.allowed_mood,'natural, cinematic, emotionally warm') AS allowed_mood, COALESCE(sb.avoid,'[]'::jsonb) AS avoid, COALESCE(sb.prompt_notes,sc.notes,'') AS prompt_notes, COALESCE(sb.content_angle,'') AS content_angle FROM scene_catalog sc LEFT JOIN scene_brief_catalog sb ON sb.avatar=sc.avatar AND sb.scene=sc.scene WHERE sc.avatar=${sql(avatar)} AND sc.scene=${sql(scene)} AND COALESCE(sc.is_enabled,true)=true AND COALESCE(sc.is_active,COALESCE(sc.is_enabled,true))=true LIMIT 1;`;\nreturn {json:{ok:true,skipQuery:false,query,avatar,scene}};\n"
      },

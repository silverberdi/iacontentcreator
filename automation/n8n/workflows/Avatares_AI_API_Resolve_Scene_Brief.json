    {
      "parameters": {
        "jsCode": "\nconst p=$('Build Scene Brief Query').first().json; const row=$input.first()?.json||{};\nif(!row.scene) return [{json:{ok:false,resolved:false,error:'Scene brief not found or inactive',avatar:p.avatar,scene:p.scene}}];\nlet avoid=row.avoid||[]; if(typeof avoid==='string'){try{avoid=JSON.parse(avoid)}catch{avoid=[]}}\nreturn [{json:{ok:true,resolved:true,avatar:row.avatar,scene:row.scene,displayName:row.display_name,visualIntent:row.visual_intent,allowedMood:row.allowed_mood,avoid,promptNotes:row.prompt_notes,contentAngle:row.content_angle}}];\n"

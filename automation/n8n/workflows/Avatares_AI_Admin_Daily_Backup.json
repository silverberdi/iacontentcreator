        "mode": "runOnceForEachItem",
        "jsCode": "try {\n  const backup = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://backup-runner:8080/backups/create',\n    headers: { 'Content-Type': 'application/json' },\n    body: { requestedBy: 'n8n-daily-schedule' },\n    json: true,\n  });\n\n  const prune = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://backup-runner:8080/backups/prune',\n    headers: { 'Content-Type': 'application/json' },\n    body: { keepLast: 14, dryRun: false },\n    json: true,\n  });\n\n  return { json: { ok: true, scheduledBackup: true, backup, prune } };\n} catch (error) {\n  return { json: { ok: false, scheduledBackup: true, message: error.message, error: error.description || error.cause || null } };\n}\n"
      },

        "jsCode": "try {\n  const body = $json.body || {};\n\n  const ingest = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://auto-ingest-runner:8090/ingest/run',\n    headers: { 'Content-Type': 'application/json' },\n    body: {\n      avatar: body.avatar,\n      avatarShort: body.avatarShort,\n      scene: body.scene,\n      assetType: body.assetType,\n      workflow: body.workflow,\n      model: body.model,\n      seed: body.seed,\n      version: body.version,\n      autoPromoteLatest: body.autoPromoteLatest,\n      baseUrl: body.baseUrl,\n    },\n    json: true,\n  });\n\n  return {\n    json: {\n      ok: true,\n      stage: 'auto-ingest',\n      ingest,\n      pipelineRequested: ingest.movedCount > 0,\n    },\n  };\n} catch (error) {\n  return {\n    json: {\n      ok: false,\n      stage: 'auto-ingest',\n      message: error.message,\n      error: error.description || error.cause || null,\n    },\n  };\n}\n"
      },

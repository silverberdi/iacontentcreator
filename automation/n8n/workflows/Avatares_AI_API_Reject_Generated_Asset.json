        "mode": "runOnceForEachItem",
        "jsCode": "function sql(value) {\n  if (value === undefined || value === null || value === '') return 'NULL';\n  return `'${String(value).replace(/'/g, \"''\")}'`;\n}\nfunction sqlJson(value) {\n  return `${sql(JSON.stringify(value ?? {}))}::jsonb`;\n}\nfunction slug(value, fallback = '') { return String(value || fallback || '').trim(); }\nconst body=$json.body||{}; const generatedAssetId=String(body.generatedAssetId||body.generated_asset_id||'').trim(); const notes=String(body.reviewNotes||body.review_notes||'Rejected from generated asset review').trim(); const re=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif(!re.test(generatedAssetId)) return {json:{ok:false,skipQuery:true,error:'generatedAssetId is required UUID',generatedAssetId}};\nconst finalStatus = 'rejected' === 'rejected' ? (['rejected','needs_fix'].includes(String(body.status||'rejected')) ? String(body.status||'rejected') : 'rejected') : 'approved';\nconst query=`UPDATE generated_assets SET status=${sql(finalStatus)}, review_notes=${sql(notes)}, approved_at=CASE WHEN ${sql(finalStatus)}='approved' THEN now() ELSE approved_at END, rejected_at=CASE WHEN ${sql(finalStatus)}='rejected' THEN now() ELSE rejected_at END, updated_at=now() WHERE generated_asset_id=${sql(generatedAssetId)}::uuid RETURNING *;`;\nreturn {json:{skipQuery:false,query,generatedAssetId}};\n"
      },

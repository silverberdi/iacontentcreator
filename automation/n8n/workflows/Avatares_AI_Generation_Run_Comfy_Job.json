    {
      "parameters": {
        "jsCode": "const row = $input.first()?.json || {};\n\nfunction parse(value, fallback) {\n  if (value === undefined || value === null) return fallback;\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch {\n      return fallback;\n    }\n  }\n  return value;\n}\n\nconst promptPack = parse(row.prompt_pack, {});\n\nreturn [\n  {\n    json: {\n      ok: true,\n      running: true,\n      manual: true,\n      job: {\n        jobId: row.job_id,\n        avatar: row.avatar,\n        scene: row.scene,\n        assetType: row.asset_type,\n        platform: row.platform,\n        status: row.status,\n        runMode: row.run_mode,\n        startedAt: row.started_at\n      },\n      promptPack,\n      instructions: [\n        'Use this prompt pack in ComfyUI / Comfy Cloud.',\n        'Export generated images to comfy-output.',\n        'Run auto-ingest pipeline to register generated assets.',\n        'Then call /generation/generated/register with jobId and assetId.'\n      ]\n    }\n  }\n];"
      },

        "mode": "runOnceForEachItem",
        "jsCode": "function sql(value) {\n  if (value === undefined || value === null || value === '') return 'NULL';\n  return `'${String(value).replace(/'/g, \"''\")}'`;\n}\nfunction sqlJson(value) {\n  return `${sql(JSON.stringify(value ?? {}))}::jsonb`;\n}\nfunction slug(value, fallback = '') { return String(value || fallback || '').trim(); }\nconst crypto=require('crypto'); const body=$json.body||{}; const jobId=crypto.randomUUID(); const avatar=slug(body.avatar); const scene=slug(body.scene); const assetType=slug(body.assetType||body.asset_type,'raw-image'); const platform=slug(body.platform,'instagram'); const promptPack=body.promptPack||body.prompt_pack||{}; const re=/^[a-z0-9][a-z0-9-]*$/i;\nif(!re.test(avatar)||!re.test(scene)||!re.test(assetType)) return {json:{ok:false,skipQuery:true,error:'avatar, scene and assetType are required slug-like values',request:{avatar,scene,assetType}}};\nconst query=`INSERT INTO generation_jobs (job_id,avatar,scene,asset_type,platform,status,prompt_pack,request_payload) VALUES (${sql(jobId)}::uuid,${sql(avatar)},${sql(scene)},${sql(assetType)},${sql(platform)},'pending',${sqlJson(promptPack)},${sqlJson(body)}) RETURNING *;`;\nreturn {json:{ok:true,skipQuery:false,query}};\n"
      },

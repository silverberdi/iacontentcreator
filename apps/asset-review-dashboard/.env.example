# Dev: use localhost proxy (see vite.config.ts) to avoid CORS
VITE_N8N_WEBHOOK_BASE_URL=http://localhost:5173/webhook
# Direct to n8n (curl / production without Vite proxy):
# VITE_N8N_WEBHOOK_BASE_URL=http://192.168.0.194:5678/webhook
VITE_MINIO_BASE_URL=http://192.168.0.194:9000
# Paste the literal token — shell vars like $AVATARES_API_KEY are NOT expanded
VITE_AVATARES_API_KEY=replace-with-your-local-production-token

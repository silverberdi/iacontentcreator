# Browser calls the authenticated gateway; the gateway proxies to n8n.
VITE_N8N_WEBHOOK_BASE_URL=/webhook
VITE_MINIO_BASE_URL=http://192.168.0.194:9000

# Gateway runtime configuration (not exposed to browser JS)
PORT=8088
PUBLIC_BASE_URL=http://192.168.0.194:8088
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
AVATARES_API_KEY=replace-with-local-production-token
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SESSION_SECRET=replace-with-32-plus-random-bytes
AUTH_STORE_PATH=/data/auth-users.json

# n8n runtime configuration for publication brief generation (server-side only)
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Optional local direct-to-n8n dev mode only:
# VITE_N8N_WEBHOOK_BASE_URL=http://localhost:5173/webhook
# VITE_AVATARES_API_KEY=replace-with-local-production-token
